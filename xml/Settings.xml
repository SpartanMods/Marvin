<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi settings hub -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_Window</include>
	<controls>
		<include>Background_Solid</include>
		<control type="label">
			<left>96</left><top>40</top><width>1300</width><height>60</height>
			<font>Title</font><label>$LOCALIZE[5]</label>
		</control>
		<include>Clock</include>
		<control type="panel" id="9000">
			<left>72</left><top>150</top><width>1800</width><height>880</height>
			<orientation>vertical</orientation>
			<itemlayout width="444" height="190">
				<include content="Settings_Tile"><param name="focused" value="false"/></include>
			</itemlayout>
			<focusedlayout width="444" height="190">
				<include content="Settings_Tile"><param name="focused" value="true"/></include>
			</focusedlayout>
			<content>
				<item><label>Marvin</label><label2>$LOCALIZE[31150]</label2><property name="icon">$VAR[Icon_Film]</property><onclick>ActivateWindow(SkinSettings)</onclick></item>
				<item><label>$LOCALIZE[14200]</label><label2>$LOCALIZE[31151]</label2><property name="icon">$VAR[Icon_Play]</property><onclick>ActivateWindow(PlayerSettings)</onclick></item>
				<item><label>$LOCALIZE[14212]</label><label2>$LOCALIZE[31152]</label2><property name="icon">$VAR[Icon_Folder]</property><onclick>ActivateWindow(MediaSettings)</onclick></item>
				<item><label>$LOCALIZE[14202]</label><label2>$LOCALIZE[31153]</label2><property name="icon">$VAR[Icon_Movie]</property><onclick>ActivateWindow(LibrarySettings)</onclick></item>
				<item><label>$LOCALIZE[14036]</label><label2>$LOCALIZE[31154]</label2><property name="icon">$VAR[Icon_Globe]</property><onclick>ActivateWindow(ServiceSettings)</onclick></item>
				<item><label>$LOCALIZE[14206]</label><label2>$LOCALIZE[31155]</label2><property name="icon">$VAR[Icon_Sliders]</property><onclick>ActivateWindow(InterfaceSettings)</onclick></item>
				<item><label>$LOCALIZE[13200]</label><label2>$LOCALIZE[31156]</label2><property name="icon">$VAR[Icon_User]</property><onclick>ActivateWindow(Profiles)</onclick></item>
				<item><label>$LOCALIZE[13000]</label><label2>$LOCALIZE[31157]</label2><property name="icon">$VAR[Icon_Gear]</property><onclick>ActivateWindow(SystemSettings)</onclick></item>
				<item><label>$LOCALIZE[24001]</label><label2>$LOCALIZE[31158]</label2><property name="icon">$VAR[Icon_Grid]</property><onclick>ActivateWindow(AddonBrowser)</onclick></item>
				<item><label>$LOCALIZE[7]</label><label2>$LOCALIZE[31159]</label2><property name="icon">$VAR[Icon_Folder]</property><onclick>ActivateWindow(FileManager)</onclick></item>
				<item><label>$LOCALIZE[130]</label><label2>$LOCALIZE[31160]</label2><property name="icon">$VAR[Icon_Info]</property><onclick>ActivateWindow(SystemInfo)</onclick></item>
				<item><label>$LOCALIZE[14111]</label><label2>$LOCALIZE[31161]</label2><property name="icon">$VAR[Icon_List]</property><onclick>ActivateWindow(EventLog,events://,return)</onclick></item>
			</content>
		</control>
	</controls>
</window>

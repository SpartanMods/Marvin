<?xml version="1.0" encoding="UTF-8"?>
<!-- Kodi: 30 heading, 31 text, 32 progress (background tasks such as library scans) -->
<window>
	<include>Anim_SlideUp</include>
	<controls>
		<control type="group">
			<right>96</right><bottom>60</bottom><width>560</width><height>120</height>
			<include content="Panel_Glass"/>
			<control type="label" id="30">
				<left>28</left><top>18</top><width>504</width><height>36</height>
				<font>LabelBold</font>
			</control>
			<control type="label" id="31">
				<left>28</left><top>54</top><width>504</width><height>32</height>
				<font>Small</font>
				<textcolor>text_muted</textcolor>
			</control>
			<control type="progress" id="32">
				<left>28</left><top>96</top><width>504</width><height>6</height>
				<texturebg border="3" colordiffuse="progress_track">common/pill16.png</texturebg>
				<midtexture border="3" colordiffuse="progress_fill">common/pill16.png</midtexture>
			</control>
		</control>
	</controls>
</window>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Yes/No, OK and progress dialogs. Kodi: 1 heading, 9 text, 10 no, 11 yes, 12 custom, 20 progress -->
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<include>Anim_Dialog</include>
	<controls>
		<include>Dialog_Scrim</include>
		<control type="group">
			<include content="Dialog_Frame"><param name="w" value="1000"/><param name="h" value="520"/></include>
			<control type="textbox" id="9">
				<left>48</left><top>110</top><width>904</width><height>240</height>
				<font>BodyLarge</font>
				<textcolor>text</textcolor>
			</control>
			<control type="progress" id="20">
				<left>48</left><top>350</top><width>904</width><height>8</height>
				<texturebg border="4" colordiffuse="progress_track">common/pill16.png</texturebg>
				<midtexture border="4" colordiffuse="progress_fill">common/pill16.png</midtexture>
				<info>System.Progressbar</info>
			</control>
			<control type="grouplist" id="9000">
				<left>48</left><top>400</top><width>904</width><height>80</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>16</itemgap>
				<include content="Dialog_Button"><param name="id" value="12"/></include>
				<include content="Dialog_Button"><param name="id" value="10"/></include>
				<include content="Dialog_Button"><param name="id" value="11"/></include>
			</control>
		</control>
	</controls>
</window>

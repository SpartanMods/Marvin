<?xml version="1.0" encoding="UTF-8"?>
<!--
	Info screen (DialogVideoInfo). Kodi contract: 8 Play, 9 Resume, 11 Trailer,
	50 cast (filled by Kodi). One window: moving down to the rows slides the hero
	up ("Info_Rows" state) instead of opening another window.
-->
<includes>
	<expression name="Info_Rows">Control.HasFocus(50) | Control.HasFocus(5100)</expression>

	<variable name="Info_PlayLabel">
		<value condition="ListItem.IsResumable">$LOCALIZE[31121]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)">$LOCALIZE[31122]</value>
		<value>$LOCALIZE[208]</value>
	</variable>

	<include name="Info_Hero">
		<control type="group">
			<left>96</left>
			<top>150</top>
			<animation effect="slide" end="0,-420" time="280" tween="cubic" easing="out" condition="$EXP[Info_Rows]" reversible="true">Conditional</animation>
			<animation effect="fade" end="0" time="200" condition="$EXP[Info_Rows]" reversible="true">Conditional</animation>
			<control type="group">
				<include content="Logo">
					<param name="width" value="1000"/>
					<param name="height" value="210"/>
					<param name="font" value="Display"/>
					<param name="fb_top" value="120"/><param name="fb_h" value="90"/>
				</include>
			</control>
			<!-- Episodes: episode title under the show logo -->
			<control type="label">
				<top>222</top>
				<width>1200</width>
				<height>50</height>
				<font>Title</font>
				<label>$INFO[ListItem.Title]</label>
				<visible>String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,season)</visible>
			</control>
			<control type="group">
				<top>222</top>
				<visible>!String.IsEqual(ListItem.DBType,episode) + !String.IsEqual(ListItem.DBType,season)</visible>
				<include content="MetaLine"/>
			</control>
			<control type="group">
				<top>276</top>
				<visible>String.IsEqual(ListItem.DBType,episode) | String.IsEqual(ListItem.DBType,season)</visible>
				<include content="MetaLine"><param name="genre" value="false"/></include>
			</control>
			<control type="group">
				<top>334</top>
				<include>MediaFlags</include>
			</control>
			<control type="textbox">
				<top>398</top>
				<width>980</width>
				<height>132</height>
				<font>Body</font>
				<label>$INFO[ListItem.Plot]</label>
			</control>
		</control>
	</include>

	<include name="Info_Buttons">
		<control type="grouplist" id="9000">
			<left>96</left>
			<top>718</top>
			<width>1500</width>
			<height>80</height>
			<orientation>horizontal</orientation>
			<itemgap>16</itemgap>
			<ondown>50</ondown>
			<animation effect="slide" end="0,-420" time="280" tween="cubic" easing="out" condition="$EXP[Info_Rows]" reversible="true">Conditional</animation>
			<animation effect="fade" end="0" time="200" condition="$EXP[Info_Rows]" reversible="true">Conditional</animation>
			<include content="Info_Button">
				<param name="id" value="9"/>
				<param name="width" value="290"/>
				<param name="left" value="9"/><param name="right" value="8"/>
				<param name="label" value="$LOCALIZE[31121]"/>
				<param name="icon" value="$VAR[Icon_Play]"/>
				<param name="visible" value="ListItem.IsResumable"/>
			</include>
			<include content="Info_Button">
				<param name="id" value="8"/>
				<param name="width" value="350"/>
				<param name="left" value="9"/><param name="right" value="11"/>
				<param name="label" value="$VAR[Info_PlayLabel_Start]"/>
				<param name="icon" value="$VAR[Info_PlayIcon_Start]"/>
			</include>
			<include content="Info_Button">
				<param name="id" value="11"/>
				<param name="width" value="280"/>
				<param name="left" value="8"/><param name="right" value="5200"/>
				<param name="label" value="$LOCALIZE[20410]"/>
				<param name="icon" value="$VAR[Icon_Trailer]"/>
				<param name="visible" value="!String.IsEmpty(ListItem.Trailer)"/>
			</include>
			<include content="Info_Button">
				<param name="id" value="5200"/>
				<param name="width" value="240"/>
				<param name="left" value="11"/><param name="right" value="5200"/>
				<param name="label" value="$LOCALIZE[31123]"/>
				<param name="icon" value="$VAR[Icon_More]"/>
				<param name="onclick" value="Action(ContextMenu)"/>
			</include>
		</control>
		<!-- Resume progress under the buttons -->
		<control type="group">
			<left>96</left>
			<top>812</top>
			<visible>ListItem.IsResumable</visible>
			<animation effect="fade" end="0" time="200" condition="$EXP[Info_Rows]" reversible="true">Conditional</animation>
			<control type="progress">
				<width>280</width>
				<height>6</height>
				<texturebg border="3" colordiffuse="progress_track">common/pill16.png</texturebg>
				<midtexture border="3" colordiffuse="progress_fill">common/pill16.png</midtexture>
				<info>ListItem.PercentPlayed</info>
			</control>
			<control type="label">
				<left>300</left>
				<top>-17</top>
				<width>600</width>
				<height>40</height>
				<font>Small</font>
				<textcolor>text_muted</textcolor>
				<label>$INFO[ListItem.PercentPlayed,,% $LOCALIZE[31124]]</label>
			</control>
		</control>
	</include>
	<variable name="Info_PlayLabel_Start">
		<value condition="ListItem.IsResumable">$LOCALIZE[31125]</value>
		<value>$VAR[Info_PlayLabel]</value>
	</variable>
	<variable name="Info_PlayIcon_Start">
		<value condition="ListItem.IsResumable">$VAR[Icon_Refresh]</value>
		<value condition="String.IsEqual(ListItem.DBType,tvshow) | String.IsEqual(ListItem.DBType,season)">$VAR[Icon_List]</value>
		<value>$VAR[Icon_Play]</value>
	</variable>

	<!-- Pill button with a leading icon (fixed width: groups cannot auto-size) -->
	<include name="Info_Button">
		<param name="id"/>
		<param name="label"/>
		<param name="icon"/>
		<param name="width">240</param>
		<param name="left"/>
		<param name="right"/>
		<param name="visible">true</param>
		<param name="onclick">noop</param>
		<definition>
			<control type="group">
				<width>$PARAM[width]</width>
				<height>76</height>
				<visible>$PARAM[visible]</visible>
				<control type="button" id="$PARAM[id]">
					<width>$PARAM[width]</width>
					<height>76</height>
					<font>LabelBold</font>
					<label>$PARAM[label]</label>
					<align>left</align>
					<aligny>center</aligny>
					<textoffsetx>78</textoffsetx>
					<textcolor>text</textcolor>
					<focusedcolor>text_dark</focusedcolor>
					<texturefocus border="24" colordiffuse="focus_fill">common/pill48.png</texturefocus>
					<texturenofocus border="24" colordiffuse="accent_soft">common/pill48.png</texturenofocus>
					<onclick>$PARAM[onclick]</onclick>
					<onleft>$PARAM[left]</onleft>
					<onright>$PARAM[right]</onright>
					<ondown>50</ondown>
				</control>
				<control type="label">
					<left>30</left>
					<width>40</width>
					<height>76</height>
					<font>IconFill32</font>
					<textcolor>text_dark</textcolor>
					<label>$PARAM[icon]</label>
					<visible>Control.HasFocus($PARAM[id])</visible>
				</control>
				<control type="label">
					<left>30</left>
					<width>40</width>
					<height>76</height>
					<font>IconFill32</font>
					<label>$PARAM[icon]</label>
					<visible>!Control.HasFocus($PARAM[id])</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- ============ Rows ============ -->
	<include name="Info_Rows">
		<control type="group">
			<top>870</top>
			<animation effect="slide" end="0,-640" time="280" tween="cubic" easing="out" condition="$EXP[Info_Rows]" reversible="true">Conditional</animation>
			<!-- Cast -->
			<control type="label">
				<left>96</left>
				<width>800</width>
				<height>40</height>
				<font>LabelBold</font>
				<label>$LOCALIZE[206]</label>
				<visible>Integer.IsGreater(Container(50).NumItems,0) + !String.IsEqual(ListItem.DBType,set)</visible>
			</control>
			<control type="list" id="50">
				<left>56</left>
				<top>20</top>
				<width>1864</width>
				<height>320</height>
				<orientation>horizontal</orientation>
				<onup>9000</onup>
				<ondown>5100</ondown>
				<visible>!String.IsEqual(ListItem.DBType,set)</visible>
				<itemlayout width="210" height="320">
					<include content="Info_CastItem"/>
				</itemlayout>
				<focusedlayout width="210" height="320">
					<control type="group">
						<include>Anim_CardFocus</include>
						<control type="image">
							<left>0</left><top>0</top><width>240</width><height>240</height>
							<texture colordiffuse="focus_glow">common/glow.png</texture>
							<visible>Control.HasFocus(50)</visible>
						</control>
						<include content="Info_CastItem"/>
					</control>
				</focusedlayout>
			</control>
			<!-- Collection -->
			<control type="group">
				<top>380</top>
				<visible>Integer.IsGreater(ListItem.SetId,0) + String.IsEqual(ListItem.DBType,movie)</visible>
				<control type="label">
					<left>96</left>
					<width>1200</width>
					<height>40</height>
					<font>LabelBold</font>
					<label>$INFO[ListItem.Set]</label>
				</control>
				<control type="list" id="5100">
					<left>56</left>
					<top>12</top>
					<width>1864</width>
					<height>380</height>
					<orientation>horizontal</orientation>
					<onup>50</onup>
					<onclick>Action(Info)</onclick>
					<content target="videos">videodb://movies/sets/$INFO[ListItem.SetId]/</content>
					<include content="Layouts_Poster">
						<param name="id" value="5100"/>
					</include>
				</control>
			</control>
		</control>
	</include>

	<include name="Info_CastItem">
		<control type="image">
			<left>40</left><top>40</top><width>160</width><height>160</height>
			<texture colordiffuse="bg_raised">common/circle.png</texture>
		</control>
		<control type="label">
			<left>40</left><top>40</top><width>160</width><height>160</height>
			<align>center</align>
			<font>Icon56</font>
			<textcolor>text_faint</textcolor>
			<label>$VAR[Icon_User]</label>
			<visible>String.IsEmpty(ListItem.Art(thumb))</visible>
		</control>
		<control type="image">
			<left>40</left><top>40</top><width>160</width><height>160</height>
			<aspectratio scalediffuse="false">scale</aspectratio>
			<texture diffuse="masks/circle.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
		</control>
		<control type="label">
			<left>20</left><top>212</top><width>200</width><height>36</height>
			<align>center</align>
			<font>Label</font>
			<label>$INFO[ListItem.Label]</label>
		</control>
		<control type="label">
			<left>20</left><top>246</top><width>200</width><height>32</height>
			<align>center</align>
			<font>Small</font>
			<textcolor>text_muted</textcolor>
			<label>$INFO[ListItem.Label2]</label>
		</control>
	</include>
</includes>
